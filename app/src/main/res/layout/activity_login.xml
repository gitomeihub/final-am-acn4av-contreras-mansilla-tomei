<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barber_color_fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:id="@+id/txtTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="BARBERÍA"
        android:textColor="@color/barber_color_dorado"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSubtituloLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="Iniciá sesión para continuar"
        android:textAlignment="center"
        android:textColor="@color/barber_color_texto_secundario"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etEmailLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="18dp"
        android:backgroundTint="@color/barber_color_dorado"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:textColor="@color/barber_color_texto"
        android:textColorHint="@color/barber_color_texto_secundario" />

    <EditText
        android:id="@+id/etPasswordLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/barber_color_dorado"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:textColor="@color/barber_color_texto"
        android:textColorHint="@color/barber_color_texto_secundario" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:backgroundTint="@color/barber_color_dorado"
        android:text="Iniciar sesión"
        android:textAllCaps="false"
        android:textColor="@color/barber_color_fondo"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCrearCuenta"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/barber_color_tarjeta"
        android:text="Crear cuenta"
        android:textAllCaps="false"
        android:textColor="@color/barber_color_texto"
        android:textSize="17sp" />

</LinearLayout>