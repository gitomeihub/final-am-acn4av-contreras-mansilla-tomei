<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barber_color_fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Panel de administrador"
        android:textColor="@color/barber_color_dorado"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="Gestioná turnos, servicios, precios e imágenes de la barbería."
        android:textAlignment="center"
        android:textColor="@color/barber_color_texto"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnAdminTurnos"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:backgroundTint="@color/barber_color_dorado"
        android:text="Ver y gestionar turnos"
        android:textAllCaps="false"
        android:textColor="@color/barber_color_fondo"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnAdminServicios"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/barber_color_tarjeta"
        android:text="Gestionar servicios"
        android:textAllCaps="false"
        android:textColor="@color/barber_color_texto"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnCerrarSesionAdmin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#8B0000"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="@color/barber_color_texto"
        android:textSize="17sp" />

</LinearLayout>