<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barber_color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <Button
            android:id="@+id/btnVolverAdminServicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/barber_color_tarjeta"
            android:text=" Volver al panel"
            android:textAllCaps="false"
            android:textColor="@color/barber_color_texto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Gestión de servicios"
            android:textAlignment="center"
            android:textColor="@color/barber_color_dorado"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Agregá, editá o eliminá servicios de la barbería."
            android:textAlignment="center"
            android:textColor="@color/barber_color_texto_secundario"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Agregar nuevo servicio"
            android:textColor="@color/barber_color_dorado"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreNuevoServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/barber_color_dorado"
            android:hint="Nombre del servicio"
            android:textColor="@color/barber_color_texto"
            android:textColorHint="@color/barber_color_texto_secundario" />

        <EditText
            android:id="@+id/etPrecioNuevoServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/barber_color_dorado"
            android:hint="Precio"
            android:textColor="@color/barber_color_texto"
            android:textColorHint="@color/barber_color_texto_secundario" />

        <EditText
            android:id="@+id/etDescripcionNuevoServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/barber_color_dorado"
            android:hint="Descripción"
            android:textColor="@color/barber_color_texto"
            android:textColorHint="@color/barber_color_texto_secundario" />

        <EditText
            android:id="@+id/etImagenNuevoServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/barber_color_dorado"
            android:hint="URL de imagen"
            android:inputType="textUri"
            android:textColor="@color/barber_color_texto"
            android:textColorHint="@color/barber_color_texto_secundario" />

        <Button
            android:id="@+id/btnAgregarServicioAdmin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/barber_color_dorado"
            android:text="Agregar servicio"
            android:textAllCaps="false"
            android:textColor="@color/barber_color_fondo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Servicios actuales"
            android:textColor="@color/barber_color_dorado"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutServiciosAdminDinamico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>